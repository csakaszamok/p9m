ADMIN_TOKEN=change-me-to-a-strong-secret
HOST_ADDRESS=192.168.1.100
# Every address is under it: the UI (p9m.<domain>), the registry, the sandbox apps; needs a wildcard DNS record.
# lvh.me points to 127.0.0.1 (trying it on this machine). `setup.sh <domain>` sets it.
HOST_DOMAIN=lvh.me
# The UI's own address instead of p9m.<domain>, e.g. console.example.com (PUBLIC_URL too, if set)
# UI_HOST=console.example.com
# The users' own address (empty: sbx.<domain>): signing in, approving /p9m:init and the sandbox apps' sign-in.
# UI_HOST is then the admin's only. off: everyone uses UI_HOST. Register its /auth/callback with the OIDC provider too
# USER_HOST=sbx.example.com
# The sandboxes' apps under a domain of their own (empty: under HOST_DOMAIN): a bad app cannot get the UI's domain
# blocked, nor set its cookies. Its own wildcard DNS record and certificate (docs: networking.md)
# APPS_DOMAIN=example.app
DEFAULT_RUNTIME=auto
# Runtimes new sandboxes may use (empty: sysbox only). The privileged dind is for development only, never on a server
# (root in a dind sandbox can reach the host): ALLOWED_RUNTIMES=sysbox,dind, or all. kata (a VM per sandbox) needs a host
# set up with scripts/install-kata.sh: ALLOWED_RUNTIMES=sysbox,kata
ALLOWED_RUNTIMES=
# The range the kata runtime takes each sandbox's own network from, a /28 per sandbox (default 10.213.0.0/16). It must not
# overlap the host's Docker address pools
# SANDBOX_SUBNET_POOL=10.213.0.0/16
DEFAULT_TEMPLATE=starter
# The direct plain-HTTP API port 8081: 127.0.0.1 (empty: the default) on this machine only; 0.0.0.0 opens it to
# every network, without TLS (tokens cross it readable): only on a trusted network, and never with a public address
P9M_API_BIND=
# off: the server never asks GitHub for the star and fork counts shown in the topbar
GITHUB_STATS=on
# off: no GitHub card in the topbar at all
GITHUB_LINK=on
# true: users can switch between the Simple and the Advanced view (otherwise they stay in Simple; the admin always can)
USER_VIEW_SWITCH=false
# The name and logo at the top left, on the sign-in page and in the tab titles (none = hidden).
# The name: empty for the default (Purgatorium Agentium), or your own.
# The logo: empty for Purgatorium's, an https:// address, or an image in ./data (UI_LOGO=/app/data/logo.png)
UI_TITLE=
UI_LOGO=
# off: the public sign-in page does not show the sandbox places on the server (taken / free)
LOGIN_CAPACITY=on
# CPU / memory per sandbox (the sandbox and everything in it); users can raise theirs up to the MAX, the admin beyond
SANDBOX_CPUS=2
SANDBOX_MEMORY=4g
SANDBOX_MAX_CPUS=4
SANDBOX_MAX_MEMORY=8g
# How long a user's sandbox may stay awake idle, and asleep before deep sleep, at most (empty: no limit; e.g. 2h, 1d)
SANDBOX_MAX_IDLE_TIMEOUT=
SANDBOX_MAX_DEEP_SLEEP_AFTER=
# Disk use above which a sandbox is flagged (a warning only)
SANDBOX_DISK=20g
# Host folders the admin may mount into a sandbox, at or under these (comma list of absolute paths, e.g. /srv/shared).
# A mount gives the sandbox's owner that host folder (as root). Empty: no mounts.
HOST_MOUNT_ROOTS=
# Running and asleep sandboxes on the whole server, the admin's too, each with a Docker network (the admin is never refused); 0 = no limit
# setup.sh replaces 200 with the number suggested for the host (check-host.sh prints it)
SANDBOX_MAX_TOTAL=200

# UI sign-in
PUBLIC_URL=http://p9m.lvh.me
SESSION_SECRET=change-me-to-a-long-random-string
# Signed out of the web UI after this long without a click or a key: empty for the default (30m), e.g. 2h, or off
SESSION_IDLE_TIMEOUT=
ADMIN_USER=admin
ADMIN_PASSWORD=change-me
# on: the admin can sign in with the user and password above. Off by default: an emergency door, not the everyday
# way in (that is OIDC with OIDC_ADMIN_EMAILS). Turn it on, `docker compose up -d`, sign in, then turn it off again.
ADMIN_LOGIN=off
# OIDC (e.g. Google: https://accounts.google.com; redirect URI = $PUBLIC_URL/auth/callback)
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_PROVIDER_NAME=Google
# Who may sign in with OIDC, as comma lists (e.g. example.com,partner.org and guest@gmail.com).
# With OIDC on, set one of them: with both empty Purgatorium refuses to start, unless OIDC_ALLOW_ANYONE=true
# lets anyone with an account at the provider in (with Google: any Google account) and create sandboxes.
OIDC_ALLOWED_DOMAINS=
OIDC_ALLOWED_EMAILS=
OIDC_ALLOW_ANYONE=false
# These addresses are the admin when they sign in with OIDC in the browser (their tokens stay a user's).
OIDC_ADMIN_EMAILS=

# The Hub: the team's published apps at hub.<HOST_DOMAIN> (docs: hub.md). Off unless true.
# Who opens a sandbox app without a p9m.access label: empty for the default (owner), or domain, or public (docs: App access)
APPS_ACCESS_DEFAULT=
HUB_ENABLED=false
# HUB_HOST=hub.example.com
# Who may look at the Hub besides the builders (OIDC_ALLOWED_*): e.g. the whole company
HUB_ALLOWED_DOMAINS=
HUB_ALLOWED_EMAILS=
HUB_TITLE=Hub

# Sandboxes a signed-in user may have running at once, guaranteed; asleep ones are not counted (0 = unlimited)
SANDBOX_QUOTA=3
# More than that while the server has room, up to this many (empty: none above SANDBOX_QUOTA; 0 = no maximum)
SANDBOX_QUOTA_MAX=

# The largest file the Files tab takes (e.g. 100m, 1g)
FILES_MAX_UPLOAD=100m

# Images whose versions all passed the secret scan can be pulled by anyone without a login (false: tokens only)
REGISTRY_PUBLIC_PULL=true

# How long the sandboxes' Docker Hub cache keeps an image, from its first download (using it does not extend it):
# in hours (720h = 30 days); 0 = for ever (the cache only grows). Before a workshop: long enough to last through it
REGISTRY_CACHE_TTL=720h
